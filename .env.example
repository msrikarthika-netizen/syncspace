# Backend
BACKEND_PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncspace_dev
DEV_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncspace_dev
PROD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncspace_prod
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRY=7d
REDIS_URL=redis://localhost:6379
REDIS_API_TOKEN=optional_redis_provider_token
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
INTERNAL_WEBHOOK_SECRET=change_this_shared_backend_ai_secret
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
ADMIN_EMAIL=admin@example.com

# AI Service
AI_PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncspace_dev
HUGGINGFACE_API_KEY=hf_your_api_key_here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HF_ROUTER_URL=https://router.huggingface.co/v1/chat/completions
REDIS_URL=redis://localhost:6379
REDIS_API_TOKEN=optional_redis_provider_token
BACKEND_URL=http://localhost:3000
INTERNAL_WEBHOOK_SECRET=change_this_shared_backend_ai_secret
LOG_LEVEL=INFO
RAG_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_VERSION=1
EMBEDDING_ALLOW_DOWNLOAD=true
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=160
RAG_RETRIEVAL_LIMIT=6
RAG_MIN_SIMILARITY=0.35

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000
VITE_AI_URL=http://localhost:8000
