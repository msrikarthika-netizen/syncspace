{
  "name": "syncspace-backend",
  "version": "1.0.0",
  "description": "SyncSpace AI Task Platform — Backend API",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "npm run lint && node --check src/index.js",
    "db:migrate": "node scripts/migrate.js",
    "admin:promote": "node scripts/promote-admin.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "gaxios": "7.3.1",
    "retry-request": "8.0.4",
    "teeny-request": "10.1.4"
  }
}
